/out/
.zig-cache/
zig-out/
/.tools/

# A contributor's global ignore file can carry patterns that happen to match a
# directory this repository owns, silently excluding source. Re-including every
# tree makes the repository's own layout authoritative regardless of what a
# personal ignore file says. Kept in step with the tree by the source-tracked
# gate, which derives its list from the directories that exist.

!agents/**
!applications/**
!boot/**
!brand/**
!communications/**
!compat/**
!core/**
!design/**
!emulator/**
!examples/**
!graphics/**
!hardware/**
!infrastructure/**
!input/**
!ipc/**
!kernel/**
!media/**
!networking/**
!packaging/**
!runtimes/**
!sdk/**
!security/**
!services/**
!session/**
!shell/**
!simulator/**
!storage/**
!store/**
!test-vectors/**
!tests/**
!tools/**

# Docs are tracked, except the private dev docs — specifications, engineering
# instructions, UI designs, and external design references — which live under
# docs/private and are local-only, never committed. A single directory keeps
# these out of the repo without listing each file, and keeps sensitive material
# in one place.
!docs/**
docs/private/

# Build outputs written to the repo root — rendered frames, session captures,
# and the built binary — are never source.
/*.png
/avOS

# Developer-local config (design reference path, etc.) — never commit.
.local/

# Vendored engine cache and its download archives, rebuilt from engines.lock.json
# by `zig build vendor-engines`.
.engines/
.engine-archives/

# Provisioned on-device model weights, fetched by `zig build fetch-model`. A device concern,
# never committed — the running OS discovers whatever model is here automatically.
.models/

# Generated icon artifacts — rebuilt by tools/icon-build, never hand-committed.
/design/icons/generated/
