.{
    // The package identity and declared capabilities for the Weather app. What an agent can
    // discover in it is exactly what is declared here and verified against its tools. Every
    // capability is a read or an ordinary local change — Weather declares no consequential one.
    .name = "Weather",
    .package = "default.weather",
    .kind = .default_app,
    .capabilities = .{ "weather.current", "weather.forecast", "weather.add_location", "weather.enable_alert" },
    .signing = .system_image,
}
