.{
    // The package identity and declared capabilities for the Music app. What an agent can discover in
    // it is exactly what is declared here and verified against its tools. Listing the library and
    // reading what is playing are silent; playing and queueing are local changes. Nothing is held.
    .name = "Music",
    .package = "default.music",
    .kind = .default_app,
    .capabilities = .{ "music.list", "music.now_playing", "music.play", "music.queue" },
    .signing = .system_image,
}
