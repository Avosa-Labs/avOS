.{
    // The package identity and declared capabilities for the Browser app. What an agent can discover
    // in it is exactly what is declared here and verified against its tools. Opening, reading,
    // bookmarking, and filling a form field are a local change or a silent read; submitting a form and
    // granting a site a sensitive permission are the consequential capabilities, held for the person.
    .name = "Browser",
    .package = "default.browser",
    .kind = .default_app,
    .capabilities = .{ "browser.open", "browser.read_page", "browser.bookmark", "browser.fill", "browser.submit", "browser.grant_site" },
    .signing = .system_image,
}
