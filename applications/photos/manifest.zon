.{
    // The package identity and declared capabilities for the Photos app. What an agent can discover in
    // it is exactly what is declared here and verified against its tools. Listing and viewing are silent,
    // importing and organising are local changes, and sharing a photo is held for the person.
    .name = "Photos",
    .package = "default.photos",
    .kind = .default_app,
    .capabilities = .{ "photo.list", "photo.view", "photo.import", "photo.favorite", "photo.album", "photo.share" },
    .signing = .system_image,
}
