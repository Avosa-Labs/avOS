.{
    // The package identity and declared capabilities for the Maps app. What an agent can discover in it
    // is exactly what is declared here and verified against its tools. Listing places and reading a
    // distance are silent, saving a place is a local change, and sharing a location is held.
    .name = "Maps",
    .package = "default.maps",
    .kind = .default_app,
    .capabilities = .{ "maps.list", "maps.distance", "maps.save", "maps.share_location" },
    .signing = .system_image,
}
